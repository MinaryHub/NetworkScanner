<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:NetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="800"
             x:Class="NetworkScanner.Avalonia.Views.IPListView">

    <UserControl.Resources>
        <helpers:StatusColorConverter x:Key="StatusColorConverter" />
        <helpers:StatusKeyIsConverter x:Key="StatusKeyIs" />
        <helpers:StatusRowBackgroundConverter x:Key="StatusRowBackground" />
        <helpers:StatusForegroundConverter x:Key="StatusForeground" />
        <helpers:RiskScoreConverter x:Key="RiskScore" />
        <helpers:BoolCheckConverter x:Key="BoolCheck" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- 상단 액션 바: 주 버튼은 항상 같은 자리에. 스캔만 틸 채움. -->
        <Border Grid.Row="0" Classes="bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="h1" VerticalAlignment="Center" Margin="0,0,24,0" Text="{helpers:Tr Key=iplist.title}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="BtnNewFile" Click="BtnNewFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="avares://NetworkScanner.Avalonia/Assets/new-file.png" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Text="{helpers:Tr Key=btn.new}" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnLoadFile" Click="BtnLoadFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="avares://NetworkScanner.Avalonia/Assets/open-file.png" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Text="{helpers:Tr Key=btn.open}" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnSaveFile" Click="BtnSaveFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="avares://NetworkScanner.Avalonia/Assets/save-file.png" Width="16" Height="16" />
                            <TextBlock VerticalAlignment="Center" Text="{helpers:Tr Key=btn.save}" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnReport" Click="BtnReport_Click">
                        <TextBlock VerticalAlignment="Center" Text="{helpers:Tr Key=btn.report.all}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 스캔 프로필(빠름/표준/정밀): 바꾸면 설정에 저장되고 다음 스캔부터 적용된다. -->
                    <ComboBox Name="CmbProfile" Width="130" VerticalAlignment="Center" SelectionChanged="CmbProfile_SelectionChanged"
                              ToolTip.Tip="{helpers:Tr Key=settings.profile}" />
                    <Button Name="BtnRefresh" Classes="primary" Click="BtnRefresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="avares://NetworkScanner.Avalonia/Assets/refresh.png" Width="16" Height="16" />
                            <TextBlock Name="TbScanLabel" VerticalAlignment="Center" Foreground="White" Text="{helpers:Tr Key=btn.scan}" />
                        </StackPanel>
                    </Button>
                    <Button Name="BtnStop" Click="BtnStop_Click" IsEnabled="False" Content="{helpers:Tr Key=btn.cancel}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 진행률 줄: 스캔 중일 때만 의미가 있다. -->
        <Border Grid.Row="1" Classes="bar" Padding="20,8">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <ProgressBar Grid.Column="0" Name="PbProgress" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="TbProgressPercent" Classes="mono caption" Margin="12,0,0,0" MinWidth="110" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 요약 타일: 숫자를 먼저, 상세 표는 그 아래. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" Margin="20,16,20,0" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="tile">
                <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="{helpers:Tr Key=tile.total}" />
                    <TextBlock Name="TbTotal" Classes="stat" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="tile">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource UpBrush}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.up}" />
                    </StackPanel>
                    <TextBlock Name="TbUp" Classes="stat" Foreground="{StaticResource UpBrush}" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Name="TileRisk" Classes="tile">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="M 6,0 L 12,10 L 0,10 Z" Fill="{StaticResource RiskBrush}" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.warn}" />
                    </StackPanel>
                    <TextBlock Name="TbRisk" Classes="stat" Foreground="{StaticResource RiskBrush}" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="tile">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.down}" />
                    </StackPanel>
                    <TextBlock Name="TbDown" Classes="stat" Foreground="{StaticResource MutedBrush}" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="tile">
                <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="{helpers:Tr Key=tile.shown}" />
                    <TextBlock Name="TbResult" Classes="stat" Text="0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 검색/필터 -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="20,12,20,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBox Name="TbSearch" Width="300" VerticalAlignment="Center"
                         Watermark="{helpers:Tr Key=search.watermark}" TextChanged="TbSearch_TextChanged" />
                <CheckBox Name="ChkAliveOnly" Content="{helpers:Tr Key=filter.aliveonly}" VerticalAlignment="Center" IsCheckedChanged="ChkAliveOnly_Changed" />
                <CheckBox Name="ChkRiskOnly" Content="{helpers:Tr Key=filter.riskonly}" VerticalAlignment="Center" IsCheckedChanged="ChkAliveOnly_Changed" />
            </StackPanel>
            <TextBlock Grid.Column="1" Name="TbMsg" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <DataGrid Grid.Row="4" Name="DgIPList" Margin="20,0,20,12" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True"
                  DoubleTapped="DgIPList_DoubleTapped">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="{Binding StatusKey, Converter={StaticResource StatusRowBackground}}" />
                    <Setter Property="Foreground" Value="{Binding StatusKey, Converter={StaticResource StatusForeground}}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{helpers:Tr Key=menu.ping}" Click="MenuItemPing_Click" />
                    <MenuItem Header="{helpers:Tr Key=menu.checkport}" Click="MenuItemCheckPort_Click" />
                    <MenuItem Header="{helpers:Tr Key=menu.checkreserved}" Click="MenuItemCheckReservedPort_Click" />
                    <MenuItem Header="{helpers:Tr Key=menu.checkprohibit}" Click="MenuItemCheckProhibitPort_Click" />
                    <Separator />
                    <MenuItem Header="{helpers:Tr Key=menu.details}" Click="MenuItemDetails_Click" />
                    <MenuItem Name="MenuItemApprove" Header="{helpers:Tr Key=menu.approve}" Click="MenuItemApprove_Click" />
                    <Separator />
                    <MenuItem Header="{helpers:Tr Key=menu.wol}" Click="MenuItemWakeOnLan_Click" />
                    <Separator />
                    <MenuItem Header="{helpers:Tr Key=menu.remove}" Click="MenuItemRemove_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{helpers:Tr Key=col.status}" Width="96" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Spacing="6">
                                <!-- 정상=원, 위험=삼각, 없음=빈 원: 색을 못 봐도 모양으로 구분된다. -->
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{StaticResource UpBrush}"
                                         IsVisible="{Binding StatusKey, Converter={StaticResource StatusKeyIs}, ConverterParameter=good}" />
                                <Path Data="M 6,0 L 12,10 L 0,10 Z" VerticalAlignment="Center" Fill="{StaticResource RiskBrush}"
                                      IsVisible="{Binding StatusKey, Converter={StaticResource StatusKeyIs}, ConverterParameter=warn}" />
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
                                         IsVisible="{Binding StatusKey, Converter={StaticResource StatusKeyIs}, ConverterParameter=bad}" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{Binding StatusKey, Converter={StaticResource StatusColorConverter}}" FontWeight="Medium" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{helpers:Tr Key=col.ip}" Binding="{Binding Ip}" IsReadOnly="True" Width="156" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.name}" Binding="{Binding SystemName}" Width="170" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.type}" Binding="{Binding DeviceType}" IsReadOnly="True" Width="120" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.os}" Binding="{Binding OsGuess}" IsReadOnly="True" Width="110" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.model}" Binding="{Binding Model}" IsReadOnly="True" Width="150" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.osversion}" Binding="{Binding OsVersion}" IsReadOnly="True" Width="170" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.ports}" Binding="{Binding Ports}" Width="150" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.service}" Binding="{Binding Service}" IsReadOnly="True" Width="190" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.mac}" Binding="{Binding Macaddr}" Width="180" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.vendor}" Binding="{Binding Vendor}" Width="150" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.rtt}" Binding="{Binding RountTime}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.switchport}" Binding="{Binding SwitchPort}" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.note}" Binding="{Binding Description}" Width="240" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{helpers:Tr Key=col.created}" Binding="{Binding CommitDate}" IsReadOnly="True" Width="160" />
                <!-- 위험 점수(0은 빈칸)와 자산 승인 표시. 저장된 컬럼 너비(인덱스 기준)와 호환되도록 맨 뒤에 둔다. -->
                <DataGridTemplateColumn Header="{helpers:Tr Key=col.risk}" Width="70" SortMemberPath="RiskScore">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RiskScore, Converter={StaticResource RiskScore}}" Classes="mono" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="8,0" Foreground="{Binding StatusKey, Converter={StaticResource StatusForeground}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{helpers:Tr Key=col.approved}" Width="70" SortMemberPath="Approved">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Approved, Converter={StaticResource BoolCheck}}" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource UpBrush}" FontWeight="Bold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단 상태줄: 마지막 메시지 한 줄 + 범례 -->
        <Border Grid.Row="5" Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Name="TbStatusLine" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource UpBrush}" />
                    <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.up}" Margin="0,0,10,0" />
                    <Path Data="M 5,0 L 10,9 L 0,9 Z" Fill="{StaticResource RiskBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.warn}" Margin="0,0,10,0" />
                    <Ellipse Width="8" Height="8" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" />
                    <TextBlock Classes="caption" Text="{helpers:Tr Key=legend.down}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
