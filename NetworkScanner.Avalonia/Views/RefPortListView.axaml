<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:NetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="NetworkScanner.Avalonia.Views.RefPortListView">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="bar">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://NetworkScanner.Avalonia/Assets/keyring.png" Width="24" Height="24" />
                <TextBlock Classes="h1" VerticalAlignment="Center" Text="{l:Tr Key=portinfo.title}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="20,16,20,20">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="section" Margin="2,0,0,8" Text="{l:Tr Key=portinfo.reserved}" />
                <ListBox Grid.Row="1" Name="LbOpenPortList" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="section" Margin="2,0,0,8" Foreground="{StaticResource RiskBrush}" Text="{l:Tr Key=portinfo.backdoor}" />
                <ListBox Grid.Row="1" Name="LbProhibitPortList" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
