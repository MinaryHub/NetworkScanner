<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NetworkScanner.Avalonia.Helpers"
        x:Class="NetworkScanner.Avalonia.Views.HostDetailsWindow"
        Title="{l:Tr Key=details.title}" Width="640" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <!-- 호스트 한 대의 식별 정보(SNMP sysDescr, 이름 출처, OS/장비 추정)와 취약점 평가 결과를 보여주는 읽기 전용 창. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Name="TbIp" Classes="h1 mono" />
            <TextBlock Name="TbName" Classes="caption" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="{l:Tr Key=details.sysdescr}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Name="TbSysDescr" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="{l:Tr Key=details.source}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Name="TbSource" Classes="mono" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="{l:Tr Key=details.os}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Name="TbOs" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="{l:Tr Key=details.device}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Name="TbDevice" />
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="caption" Text="{l:Tr Key=col.risk}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Name="TbRisk" Classes="mono" />
                <TextBlock Grid.Row="5" Grid.Column="0" Classes="caption" Text="{l:Tr Key=col.approved}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Name="TbApproved" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Name="TbFindingsHeader" Classes="section" Margin="16,12,16,8" Text="{l:Tr Key=details.findings}" />
                <ScrollViewer Grid.Row="1" Margin="16,0,16,12">
                    <ItemsControl Name="LstFindings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{Binding Brush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Where}" Classes="caption mono" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reference}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasReference}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Grid.Row="3" Name="BtnClose" Classes="primary" HorizontalAlignment="Right" Click="BtnClose_Click" Content="{l:Tr Key=details.close}" />
    </Grid>
</Window>
