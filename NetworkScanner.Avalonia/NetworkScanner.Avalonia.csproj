<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 자체에 아이콘을 임베드해 바로가기/작업표시줄에서 기본 아이콘 대신 앱 아이콘이 보이게 한다.
         (MainWindow의 Icon은 실행 중 창 아이콘일 뿐 exe 아이콘과 별개) -->
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <!-- 개발 머신에 .NET 10 런타임이 없어도(더 새 버전만 설치된 경우) 로컬 실행이 가능하도록 허용.
         self-contained 배포판에는 영향 없음(자체 런타임 포함). -->
    <RollForward>LatestMajor</RollForward>
    <!-- 릴리즈 태그 push 시 release.yml이 -p:Version=으로 실제 태그 버전을 덮어써 반영한다. -->
    <Version>1.7.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkScanner.Core\NetworkScanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 참조 데이터 파일은 저장소 루트의 data/ 에 한 벌만 두고, GUI/CLI가 링크로 실행 파일 옆에 복사한다. -->
    <None Include="..\data\ouiinfo.ini" Link="ouiinfo.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\data\prohibitports.ini" Link="prohibitports.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\data\reservedports.ini" Link="reservedports.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 아이콘 이미지는 저장소 루트의 assets/ 에서 임베드한다. -->
    <AvaloniaResource Include="..\assets\app.ico" Link="Assets/app.ico" />
    <AvaloniaResource Include="..\assets\iplist.png" Link="Assets/iplist.png" />
    <AvaloniaResource Include="..\assets\settings.png" Link="Assets/settings.png" />
    <AvaloniaResource Include="..\assets\info.png" Link="Assets/info.png" />
    <AvaloniaResource Include="..\assets\new-file.png" Link="Assets/new-file.png" />
    <AvaloniaResource Include="..\assets\open-file.png" Link="Assets/open-file.png" />
    <AvaloniaResource Include="..\assets\save-file.png" Link="Assets/save-file.png" />
    <AvaloniaResource Include="..\assets\refresh.png" Link="Assets/refresh.png" />
    <AvaloniaResource Include="..\assets\keyring.png" Link="Assets/keyring.png" />
    <AvaloniaResource Include="..\assets\setup.png" Link="Assets/setup.png" />
  </ItemGroup>
</Project>
