<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 결과 업로드: FTPS(FluentFTP), SFTP(SSH.NET). HTTPS는 HttpClient로 처리한다. -->
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Secrets/WindowsDpapiSecretStore의 Windows DPAPI 지원(런타임에는 OperatingSystem.IsWindows()로만 사용)에 필요 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- ScanHistoryStore의 SQLite 스캔 이력 저장(history.db)에 필요 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
