<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 결과 업로드: FTPS(FluentFTP), SFTP(SSH.NET). HTTPS는 HttpClient로 처리한다. -->
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Secrets/WindowsDpapiSecretStore의 Windows DPAPI 지원(런타임에는 OperatingSystem.IsWindows()로만 사용)에 필요 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- ScanHistoryStore의 SQLite 스캔 이력 저장(history.db)에 필요 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Reports/PdfReport의 PDF 리포트 생성(MIT). 시스템 폰트에 의존하지 않도록 아래 나눔고딕을 임베드해 사용한다. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Capture/PassiveListener의 수동 패킷 수집(ARP/DHCP/mDNS/SSDP/NetBIOS/TCP SYN-ACK). PacketDotNet을 함께 끌어온다.
         런타임에 libpcap(macOS 기본 포함, Linux는 libpcap, Windows는 Npcap)과 캡처 권한이 없으면 IsAvailable=false로 조용히 비활성화된다. -->
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF 리포트용 한글 폰트(나눔고딕, SIL OFL). Reports/NanumFontResolver가 매니페스트 리소스에서 읽는다. -->
    <EmbeddedResource Include="..\assets\fonts\NanumGothic*.ttf" LogicalName="NetworkScanner.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
