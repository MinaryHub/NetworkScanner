<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:KetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="KetworkScanner.Avalonia.Views.HistoryView">
    <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto,*,Auto">
        <Border Grid.Row="0" Classes="bar">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Image Source="avares://KetworkScanner.Avalonia/Assets/open-file.png" Width="24" Height="24" />
                <TextBlock Classes="h1" VerticalAlignment="Center" Text="{l:Tr Key=history.title}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="BtnRefresh" Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="avares://KetworkScanner.Avalonia/Assets/refresh.png" Width="20" Height="20" />
                        <TextBlock VerticalAlignment="Center" Text="{l:Tr Key=history.refresh}" />
                    </StackPanel>
                </Button>
                <!-- 백업/복원은 설정 화면의 '백업·지원' 카드에 있다. 정리 기준 일수는 코드에서 보존 일수 설정으로 채운다. -->
                <Button Name="BtnPrune" Classes="danger" Click="BtnPrune_Click" />
            </StackPanel>
        </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="section" Margin="22,8,0,6" Text="{l:Tr Key=history.scans}" />
        <DataGrid Grid.Row="2" Name="DgScans" Margin="20,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Tr Key=history.col.started}" Binding="{Binding Started}" Width="170" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.finished}" Binding="{Binding Finished}" Width="170" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.system}" Binding="{Binding SystemName}" Width="160" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.total}" Binding="{Binding Total}" Width="80" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.alive}" Binding="{Binding Alive}" Width="80" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.prohibited}" Binding="{Binding Prohibited}" Width="80" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.scheduled}" Binding="{Binding Scheduled}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 인벤토리: 선택한 호스트에 대해 승인/승인 해제/소유자·태그 지정. 여러 행 선택 가능. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="20,14,20,6">
            <TextBlock Grid.Column="0" Classes="section" VerticalAlignment="Center" Margin="2,0,0,0" Text="{l:Tr Key=history.inventory}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="BtnApprove" Classes="accentoutline" Click="BtnApprove_Click" IsEnabled="False" Content="{l:Tr Key=assets.approve}" />
                <Button Name="BtnUnapprove" Click="BtnUnapprove_Click" IsEnabled="False" Content="{l:Tr Key=assets.unapprove}" />
                <Button Name="BtnSetOwner" Click="BtnSetOwner_Click" IsEnabled="False" Content="{l:Tr Key=assets.setowner}" />
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="4" Name="DgInventory" Margin="20,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True" SelectionMode="Extended" SelectionChanged="DgInventory_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Tr Key=history.col.ip}" Binding="{Binding Ip}" Width="130" />
                <DataGridTextColumn Header="{l:Tr Key=assets.approved}" Binding="{Binding Approved}" Width="70" />
                <DataGridTextColumn Header="{l:Tr Key=assets.approvedmac}" Binding="{Binding ApprovedMac}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=assets.owner}" Binding="{Binding Owner}" Width="120" />
                <DataGridTextColumn Header="{l:Tr Key=assets.tags}" Binding="{Binding Tags}" Width="130" />
                <DataGridTextColumn Header="{l:Tr Key=assets.note}" Binding="{Binding Note}" Width="160" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{l:Tr Key=assets.risk}" Binding="{Binding Risk}" Width="70" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.firstseen}" Binding="{Binding FirstSeen}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.lastseen}" Binding="{Binding LastSeen}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.lastalive}" Binding="{Binding LastAlive}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.name}" Binding="{Binding LastName}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.mac}" Binding="{Binding LastMac}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.vendor}" Binding="{Binding LastVendor}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.model}" Binding="{Binding LastModel}" Width="150" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.os}" Binding="{Binding LastOs}" Width="150" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.ports}" Binding="{Binding LastPorts}" Width="140" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.seencount}" Binding="{Binding SeenCount}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 알림: 열린 것만 기본 표시. 확인/스누즈는 외부 채널 재알림을 막고, 다시 열기는 되돌린다. -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="20,14,20,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBlock Classes="section" VerticalAlignment="Center" Margin="2,0,0,0" Text="{l:Tr Key=alerts.open}" />
                <CheckBox Name="ChkShowResolved" Content="{l:Tr Key=alerts.showresolved}" IsCheckedChanged="ChkShowResolved_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="BtnAck" Classes="accentoutline" Click="BtnAck_Click" IsEnabled="False" Content="{l:Tr Key=alerts.ack}" />
                <Button Name="BtnSnooze" Click="BtnSnooze_Click" IsEnabled="False" Content="{l:Tr Key=alerts.snooze}" />
                <Button Name="BtnReopen" Click="BtnReopen_Click" IsEnabled="False" Content="{l:Tr Key=alerts.reopen}" />
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="6" Name="DgAlerts" Margin="20,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True" SelectionMode="Extended" SelectionChanged="DgAlerts_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.state}" Binding="{Binding State}" Width="100" />
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.type}" Binding="{Binding Type}" Width="200" FontFamily="{StaticResource UiFont}" />
                <DataGridTextColumn Header="{l:Tr Key=history.col.ip}" Binding="{Binding Ip}" Width="130" />
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.detail}" Binding="{Binding Detail}" Width="260" />
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.first}" Binding="{Binding First}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.last}" Binding="{Binding Last}" Width="150" />
                <DataGridTextColumn Header="{l:Tr Key=alerts.col.count}" Binding="{Binding Count}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="7" Name="TbMsg" Classes="caption" Margin="20,8,20,12" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
