<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:KetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KetworkScanner.Avalonia.Views.UserGuideView">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Image Source="avares://KetworkScanner.Avalonia/Assets/info.png" Width="24" Height="24" />
                    <TextBlock Classes="h1" VerticalAlignment="Center" Text="{l:Tr Key=guide.title}" />
                </StackPanel>
                <!-- 설명서 언어(영어/한국어)는 앱 UI 언어 설정과 별개로 즉시 전환된다. -->
                <ComboBox Grid.Column="2" Name="CbLanguage" Width="150" VerticalAlignment="Center"
                          SelectionChanged="CbLanguage_SelectionChanged" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="20,16,20,20">
            <Border Classes="card" Padding="28,20" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel Name="PnlSections" Spacing="6" />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
