<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:KetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="KetworkScanner.Avalonia.Views.SettingsView">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Image Source="avares://KetworkScanner.Avalonia/Assets/settings.png" Width="24" Height="24" />
                    <TextBlock Classes="h1" VerticalAlignment="Center" Text="{l:Tr Key=settings.title}" />
                </StackPanel>
                <Button Grid.Column="1" Name="BtnSaveFile" Classes="primary" Click="BtnSaveFile_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="avares://KetworkScanner.Avalonia/Assets/save-file.png" Width="20" Height="20" />
                        <TextBlock VerticalAlignment="Center" Foreground="White" Text="{l:Tr Key=settings.save}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="{l:Tr Key=settings.iprange}" />
                    <DataGrid Name="DgIPRange" Height="200" AutoGenerateColumns="False" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Tag="start" Header="{l:Tr Key=settings.startip}" Binding="{Binding StartIP}" Width="150" />
                            <DataGridTextColumn Tag="end" Header="{l:Tr Key=settings.endip}" Binding="{Binding EndIP}" Width="150" />
                            <DataGridTextColumn Tag="note" Header="{l:Tr Key=col.note}" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.startip}" />
                        <TextBox Name="TbStartIP" Width="150" Watermark="192.168.1.0/24" />
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.endip}" />
                        <TextBox Name="TbEndIP" Width="150" />
                        <TextBlock Width="50" VerticalAlignment="Center" Text="{l:Tr Key=settings.desc}" />
                        <TextBox Name="TbDescription" Width="150" />
                        <Button Name="BtnAddRange" Click="BtnAddRange_Click" Content="{l:Tr Key=settings.addrange}" />
                        <Button Name="BtnRemoveRange" Click="BtnRemoveRange_Click" Content="{l:Tr Key=settings.removerange}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 포트 검색과 그에 딸린 취약점 평가(열린 포트가 있어야 규칙을 적용할 수 있다). -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="section" VerticalAlignment="Center" Text="{l:Tr Key=settings.ports}" />
                        <CheckBox Name="ChkCheckPort" Content="{l:Tr Key=settings.useportcheck}" />
                        <TextBlock VerticalAlignment="Center" Text="{l:Tr Key=settings.portno}" />
                        <TextBox Name="TbPortsList" Width="400" Watermark="22/80/8080" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{l:Tr Key=settings.riskallow}" />
                        <TextBox Name="TbRiskAllow" Width="520" Watermark="{l:Tr Key=settings.riskallow.hint}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox Name="ChkVuln" Content="{l:Tr Key=settings.vuln}" />
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{l:Tr Key=settings.vuln.hint}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <CheckBox Name="ChkScheduling" Content="{l:Tr Key=settings.usescheduling}" FontWeight="Bold" />
                    <WrapPanel Name="HourCheckboxPanel" />
                </StackPanel>
            </Border>

            <!-- 결과 업로드(FTP/FTPS/SFTP/HTTPS). 비밀번호/토큰은 OS 자격 증명 저장소에 따로 보관된다. -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Classes="section" VerticalAlignment="Center" Text="{l:Tr Key=settings.upload}" />
                        <CheckBox Name="ChkUseUpload" Content="{l:Tr Key=settings.useupload}" />
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.protocol}" />
                        <ComboBox Name="CmbUploadProtocol" Width="140" Margin="0,0,12,0" SelectionChanged="CmbUploadProtocol_SelectionChanged">
                            <ComboBoxItem Tag="Ftp">FTP</ComboBoxItem>
                            <ComboBoxItem Tag="Ftps">FTPS (explicit)</ComboBoxItem>
                            <ComboBoxItem Tag="FtpsImplicit">FTPS (implicit)</ComboBoxItem>
                            <ComboBoxItem Tag="Sftp">SFTP</ComboBoxItem>
                            <ComboBoxItem Tag="Https">HTTPS</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Width="60" VerticalAlignment="Center" Text="{l:Tr Key=settings.host}" />
                        <TextBox Name="TbUploadHost" Width="200" Margin="0,0,12,0" />
                        <TextBlock Width="50" VerticalAlignment="Center" Text="{l:Tr Key=settings.port}" />
                        <TextBox Name="TbUploadPort" Width="80" Margin="0,0,4,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:Tr Key=settings.port.default}" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.user}" />
                        <TextBox Name="TbUploadUser" Width="140" Margin="0,0,12,0" />
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.password}" />
                        <TextBox Name="TbUploadPassword" Width="140" PasswordChar="●" Margin="0,0,12,0" />
                        <TextBlock Width="80" VerticalAlignment="Center" Text="{l:Tr Key=settings.remotedir}" />
                        <TextBox Name="TbUploadRemoteDir" Width="200" Watermark="/FTP" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="140" VerticalAlignment="Center" Text="{l:Tr Key=settings.fingerprint}" />
                        <TextBox Name="TbUploadFingerprint" Width="420" Margin="0,0,12,0" Watermark="AB:CD:..." />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="70" VerticalAlignment="Center" Text="{l:Tr Key=settings.token}" />
                        <TextBox Name="TbUploadToken" Width="360" PasswordChar="●" Margin="0,0,4,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.token.https}" />
                        <CheckBox Name="ChkUploadAllowInsecure" Content="{l:Tr Key=settings.allowinsecure}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 알림(웹훅/syslog/메일). 스캔 변화가 감지되면 설정된 채널로 보낸다. -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Classes="section" VerticalAlignment="Center" Text="{l:Tr Key=settings.notifications}" />
                        <CheckBox Name="ChkUseNotify" Content="{l:Tr Key=settings.usenotify}" />
                        <CheckBox Name="ChkNotifySecurityOnly" Content="{l:Tr Key=settings.securityonly}" />
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Width="100" VerticalAlignment="Center" Text="{l:Tr Key=settings.webhook}" />
                        <TextBox Name="TbWebhookUrl" Width="460" Watermark="https://hooks.slack.com/services/..." />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="100" VerticalAlignment="Center" Text="{l:Tr Key=settings.syslog}" />
                        <TextBox Name="TbSyslogHost" Width="200" Margin="0,0,12,0" />
                        <TextBlock Width="90" VerticalAlignment="Center" Text="{l:Tr Key=settings.syslogport}" />
                        <TextBox Name="TbSyslogPort" Width="80" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="100" VerticalAlignment="Center" Text="{l:Tr Key=settings.smtp}" />
                        <TextBox Name="TbSmtpHost" Width="200" Margin="0,0,12,0" />
                        <TextBlock Width="90" VerticalAlignment="Center" Text="{l:Tr Key=settings.smtpport}" />
                        <TextBox Name="TbSmtpPort" Width="80" Margin="0,0,12,0" />
                        <CheckBox Name="ChkSmtpStartTls" Content="{l:Tr Key=settings.starttls}" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="100" VerticalAlignment="Center" Text="{l:Tr Key=settings.smtpuser}" />
                        <TextBox Name="TbSmtpUser" Width="200" Margin="0,0,12,0" />
                        <TextBlock Width="110" VerticalAlignment="Center" Text="{l:Tr Key=settings.smtppassword}" />
                        <TextBox Name="TbSmtpPassword" Width="160" PasswordChar="●" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="100" VerticalAlignment="Center" Text="{l:Tr Key=settings.mailfrom}" />
                        <TextBox Name="TbMailFrom" Width="200" Margin="0,0,12,0" />
                        <TextBlock Width="90" VerticalAlignment="Center" Text="{l:Tr Key=settings.mailto}" />
                        <TextBox Name="TbMailTo" Width="300" Watermark="a@example.com, b@example.com" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 스캔 한계: 동시성과 한 번에 두드릴 최대 주소 수. -->
            <Border Classes="card">
                <WrapPanel>
                    <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.scanlimits}" />
                    <TextBlock Width="90" VerticalAlignment="Center" Text="{l:Tr Key=settings.parallelism}" />
                    <TextBox Name="TbScanParallelism" Width="80" Margin="0,0,16,0" />
                    <TextBlock Width="110" VerticalAlignment="Center" Text="{l:Tr Key=settings.maxtargets}" />
                    <TextBox Name="TbMaxTargets" Width="100" />
                </WrapPanel>
            </Border>

            <!-- 일반: 시스템 이름은 저장 파일/리포트 이름의 접두어이며 업로드 시 필수다. -->
            <Border Classes="card">
                <WrapPanel>
                    <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.general}" />
                    <TextBlock Width="90" VerticalAlignment="Center" Text="{l:Tr Key=settings.systemname}" />
                    <TextBox Name="TbCurSystemName" Width="200" Margin="0,0,6,0" />
                    <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.systemname.hint}" />
                    <CheckBox Name="ChkLoadLatestFileWhenStartup" Content="{l:Tr Key=settings.loadlatest}" Margin="0,0,24,0" />
                    <CheckBox Name="ChkContinuousMonitoring" Content="{l:Tr Key=settings.continuous}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Name="TbMonitorInterval" Width="50" Text="10" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="{l:Tr Key=settings.interval}" />
                </WrapPanel>
            </Border>

            <!-- 자산 정책: 미승인 장비 알림, 첫 스캔 자동 승인, 고위험 기준 점수. -->
            <Border Classes="card">
                <WrapPanel>
                    <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.assets}" />
                    <CheckBox Name="ChkAlertUnapproved" Content="{l:Tr Key=settings.alertunapproved}" Margin="0,0,16,0" />
                    <CheckBox Name="ChkAutoApprove" Content="{l:Tr Key=settings.autoapprove}" Margin="0,0,16,0" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.highrisk}" />
                    <TextBox Name="TbHighRisk" Width="70" Classes="mono" />
                </WrapPanel>
            </Border>

            <!-- 알림 운영: 재알림 간격과 점검 시간대(그 시간엔 기록만 하고 보내지 않음). -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <WrapPanel>
                        <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.alertops}" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.renotify}" />
                        <TextBox Name="TbRenotify" Width="70" Classes="mono" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="110" VerticalAlignment="Top" Margin="0,8,0,0" Text="{l:Tr Key=settings.maintenance}" />
                        <TextBox Name="TbMaintenance" Width="520" Height="64" AcceptsReturn="True" TextWrapping="Wrap" Classes="mono"
                                 Watermark="{l:Tr Key=settings.maintenance.hint}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 심층 발견: 이름 프로브(NetBIOS/mDNS/SNMP), 핑거프린트(SMB/SSH/HTTP/UDP), 네트워크 전체(멀티캐스트/테이블/패시브).
                 이름 프로브는 저장 즉시 반영되지만, 나머지는 시작 시 한 번 만들어지므로 재시작 후 적용된다. -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="{l:Tr Key=settings.discovery}" />
                    <WrapPanel>
                        <TextBlock Width="110" VerticalAlignment="Center" Text="{l:Tr Key=settings.discovery.names}" />
                        <CheckBox Name="ChkNetBios" Content="{l:Tr Key=settings.netbios}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkMdns" Content="{l:Tr Key=settings.mdns}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkSnmp" Content="{l:Tr Key=settings.snmp}" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Key=settings.snmp.community}" />
                        <TextBox Name="TbSnmpCommunity" Width="120" Watermark="public" Classes="mono" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="110" VerticalAlignment="Center" Text="{l:Tr Key=settings.discovery.fingerprints}" />
                        <CheckBox Name="ChkDiscSmb" Content="{l:Tr Key=settings.discovery.smb}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscSsh" Content="{l:Tr Key=settings.discovery.ssh}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscHttp" Content="{l:Tr Key=settings.discovery.http}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscUdp" Content="{l:Tr Key=settings.discovery.udp}" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Width="110" VerticalAlignment="Center" Text="{l:Tr Key=settings.discovery.network}" />
                        <CheckBox Name="ChkDiscSsdp" Content="{l:Tr Key=settings.discovery.ssdp}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscMdns" Content="{l:Tr Key=settings.discovery.mdns}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscNeighbor" Content="{l:Tr Key=settings.discovery.neighbor}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscGatewaySnmp" Content="{l:Tr Key=settings.discovery.gatewaysnmp}" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Tr Key=settings.discovery.snmpagents}" />
                        <TextBox Name="TbDiscSnmpAgents" Width="320" Classes="mono" Watermark="10.0.0.1; 10.0.0.2:community" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscActiveArp" Content="{l:Tr Key=settings.discovery.activearp}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscPassive" Content="{l:Tr Key=settings.discovery.passive}" Margin="0,0,12,0" />
                        <CheckBox Name="ChkDiscMergeHistory" Content="{l:Tr Key=settings.discovery.mergehistory}" />
                    </WrapPanel>
                    <TextBlock Name="TbDiscoveryRestart" Classes="caption" IsVisible="False" Text="{l:Tr Key=settings.discovery.restart}" />
                </StackPanel>
            </Border>

            <!-- 백업·지원: 이력 보존/백업 개수, 수동 백업·복원(복원은 다음 시작 시 적용), 설정 내보내기/가져오기, 진단 번들. -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <WrapPanel>
                        <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.backupbox}" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.retention}" />
                        <TextBox Name="TbRetention" Width="70" Classes="mono" Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.backups}" />
                        <TextBox Name="TbBackups" Width="60" Classes="mono" Margin="0,0,16,0" />
                        <Button Name="BtnBackupNow" Click="BtnBackupNow_Click" Content="{l:Tr Key=history.backup}" Margin="0,0,8,0" />
                        <Button Name="BtnRestore" Click="BtnRestore_Click" Content="{l:Tr Key=history.restore}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Name="BtnExport" Click="BtnExport_Click" Content="{l:Tr Key=settings.export}" Margin="0,0,8,0" />
                        <Button Name="BtnImport" Click="BtnImport_Click" Content="{l:Tr Key=settings.import}" Margin="0,0,8,0" />
                        <Button Name="BtnDiag" Classes="accentoutline" Click="BtnDiag_Click" Content="{l:Tr Key=settings.diag}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 자동 업데이트: 확인 주기, 백그라운드 다운로드, 종료 시 자동 설치, beta 채널. -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <WrapPanel>
                        <TextBlock Classes="section" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:Tr Key=settings.update}" />
                        <CheckBox Name="ChkUpdateAutoCheck" Content="{l:Tr Key=settings.update.autocheck}" Margin="0,0,16,0" IsCheckedChanged="ChkUpdateAutoCheck_Changed" />
                        <CheckBox Name="ChkUpdateAutoDownload" Content="{l:Tr Key=settings.update.autodownload}" Margin="0,0,16,0" />
                        <CheckBox Name="ChkUpdateAutoApply" Content="{l:Tr Key=settings.update.autoapply}" Margin="0,0,16,0" />
                        <CheckBox Name="ChkUpdatePrerelease" Content="{l:Tr Key=settings.update.prerelease}" Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.update.interval}" />
                        <TextBox Name="TbUpdateInterval" Width="60" Classes="mono" Margin="0,0,16,0" />
                        <Button Name="BtnUpdateCheck" Classes="accentoutline" Click="BtnUpdateCheck_Click" Content="{l:Tr Key=settings.update.checknow}" />
                    </WrapPanel>
                    <TextBlock Name="TbUpdateStatus" Classes="caption" />
                    <!-- 참조 데이터(참고 포트 목록·OUI·취약점 규칙) 자동 갱신: 저장소의 data/refdata.json과 비교해 새 파일만 내려받는다. -->
                    <WrapPanel>
                        <CheckBox Name="ChkRefDataAuto" Content="{l:Tr Key=settings.refdata.auto}" Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:Tr Key=settings.refdata.interval}" />
                        <TextBox Name="TbRefDataInterval" Width="60" Classes="mono" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="section" VerticalAlignment="Center" Text="{l:Tr Key=settings.language}" />
                    <ComboBox Name="CmbLanguage" Width="160" VerticalAlignment="Center">
                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                        <ComboBoxItem Tag="ko">한국어</ComboBoxItem>
                    </ComboBox>
                    <TextBlock VerticalAlignment="Center" Text="{l:Tr Key=settings.lang.restart}" />
                </StackPanel>
            </Border>

            <TextBlock Name="TbMsg" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
