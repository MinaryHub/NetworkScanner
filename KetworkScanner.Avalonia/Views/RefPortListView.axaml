<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:KetworkScanner.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KetworkScanner.Avalonia.Views.RefPortListView">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="bar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Image Source="avares://KetworkScanner.Avalonia/Assets/keyring.png" Width="24" Height="24" />
                    <TextBlock Classes="h1" VerticalAlignment="Center" Text="{l:Tr Key=portinfo.title}" />
                </StackPanel>
                <!-- 참조 데이터 버전/마지막 확인 시각. 저장소의 최신 데이터와 비교해 자동으로 갱신된다. -->
                <TextBlock Grid.Column="1" Name="TbRefStatus" Classes="caption" VerticalAlignment="Center" Margin="24,0,12,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Name="BtnRefUpdate" Classes="accentoutline" Click="BtnRefUpdate_Click" Content="{l:Tr Key=refdata.updatenow}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="20,16,20,20">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="section" Margin="2,0,0,8" Text="{l:Tr Key=portinfo.reserved}" />
                <ListBox Grid.Row="1" Name="LbOpenPortList" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="section" Margin="2,0,0,8" Foreground="{StaticResource RiskBrush}" Text="{l:Tr Key=portinfo.backdoor}" />
                <ListBox Grid.Row="1" Name="LbProhibitPortList" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
